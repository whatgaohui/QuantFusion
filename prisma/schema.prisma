generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String
  name      String?
  addedAt   DateTime @default(now())
  
  @@unique([symbol])
}

model Position {
  id            String   @id @default(cuid())
  symbol        String
  name          String?
  buyPrice      Float
  quantity       Int
  buyDate       DateTime
  cycleDays     Int      @default(7)
  stopLossPct   Float    @default(0.08)
  takeProfitPct Float    @default(0.15)
  status        String   @default("ACTIVE")  // ACTIVE, CLOSED, STOPPED
  sellPrice     Float?
  sellDate      DateTime?
  sellReason    String?   // TAKE_PROFIT, STOP_LOSS, EXPIRED, MANUAL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Alert {
  id          String   @id @default(cuid())
  symbol      String
  targetPrice Float
  condition   String   // ABOVE, BELOW
  status      String   @default("ACTIVE") // ACTIVE, TRIGGERED, EXPIRED
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TradeLog {
  id          String   @id @default(cuid())
  symbol      String
  name        String?
  action      String   // BUY, SELL
  price       Float
  quantity     Int
  reason      String?
  profitPct   Float?
  createdAt   DateTime @default(now())
}

model SignalResult {
  id          String   @id @default(cuid())
  symbol      String
  name        String?
  score       Int
  signalType  String   // BUY, SELL, HOLD
  rsi         Float?
  macdSignal  String?
  bollingerSignal String?
  kdjSignal   String?
  volumeRatio Float?
  price       Float?
  createdAt   DateTime @default(now())
}
